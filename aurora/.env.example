# Aurora environment — copy to .env and adjust
PORT=3000
NODE_ENV=production

# Auto-generated on first boot if omitted
# JWT_SECRET=

DB_PATH=data/aurora.db
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=64

# dev = in-app Dev Inbox (no SMTP needed) | smtp = real delivery
EMAIL_MODE=dev
BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aurora <no-reply@aurora.app>

# First-boot admin
ADMIN_PASSWORD=

# Rate limits (per 15 min for auth, per minute for API)
AUTH_RATELIMIT_MAX=30
LOGIN_RATELIMIT_MAX=10

# Demo accounts (@nova, @orion) — set 0 in production
DEMO_SEED=1
